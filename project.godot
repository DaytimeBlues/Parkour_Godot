; Isolated engine comparison. Never replaces Parkour Three production source.
config_version=5

[application]
config/name="Parkour · Godot Woodland Prototype"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="Private Godot web engine comparison using copied Parkour assets."

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/size/window_width_override=1280
window/size/window_height_override=720

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.45,0.65,0.67,1)

[physics]
common/physics_ticks_per_second=60
3d/physics_engine="GodotPhysics3D"

[audio]
driver/enable_input=false
